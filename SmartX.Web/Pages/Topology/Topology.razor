@page "/topology"
@inject HttpClient Http
@inject DashboardState State
@implements IDisposable

<PageTitle>Topology - Smart-X</PageTitle>

<PageHeader Title="Topology"
            Blurb="How the devices link up to reach the gateway, and which links are carrying a site." />

@if (_loadFailed)
{
    <div class="alert alert-danger">
        Cannot reach the gateway. The mesh on this page may be out of date.
    </div>
}

@if (_mesh == null && !_loadFailed)
{
    <div class="text-center text-muted py-4">
        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
        Loading...
    </div>
}
else if (_mesh is { Nodes.Count: 0 })
{
    <div class="card mb-4">
        <div class="card-body text-center text-muted py-5">
            No links reported yet. Start the simulator and the mesh will fill in.
        </div>
    </div>
}
else if (_mesh != null)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <span class="text-muted small">
            @_mesh.Nodes.Count devices, @_mesh.Links.Count links
        </span>

        @if (_lastUpdated != null)
        {
            <span class="text-muted small">
                <span class="live-dot me-1"></span>Updated @_lastUpdated.Value.ToLocalTime().ToString("HH:mm:ss")
            </span>
        }
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <h2 class="h5 mb-0">Mesh</h2>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn @(_treeOnly ? "btn-outline-primary" : "btn-primary")" @onclick="() => _treeOnly = false">All links</button>
                    <button type="button" class="btn @(_treeOnly ? "btn-primary" : "btn-outline-primary")" @onclick="() => _treeOnly = true">Tree only</button>
                </div>
            </div>

            <svg class="mesh-svg" viewBox="0 0 500 500" role="img" aria-label="Drawing of the mesh">
                @foreach (var link in _mesh.Links)
                {
                    var inTree = InTree(link);

                    if (_treeOnly && !inTree)
                    {
                        continue;
                    }

                    var from = Position(link.MacA);
                    var to = Position(link.MacB);

                    <line class="mesh-link @(inTree ? "mesh-link-tree" : "") @(IsQuietLink(link) ? "mesh-link-quiet" : "") @(InRoute(link) ? "mesh-link-route" : "")"
                          x1="@from.X" y1="@from.Y" x2="@to.X" y2="@to.Y">
                        <title>@link.MacA to @link.MacB, @link.Rssi dBm</title>
                    </line>
                }

                @foreach (var node in _mesh.Nodes)
                {
                    var spot = Position(node.MacAddress);

                    <circle class="mesh-node @NodeClass(node) @(IsSelected(node) ? "mesh-node-selected" : "")" cx="@spot.X" cy="@spot.Y" r="@(node.IsGateway ? 12 : 7)"
                            @onclick="() => SelectNode(node.MacAddress)">
                        <title>@node.Name (@node.MacAddress), hops @(node.HopCount?.ToString() ?? "-")</title>
                    </circle>
                }
            </svg>

            <div class="text-muted small">
                Blue is up, orange is quiet, red is cut off from the gateway, black is the gateway. Thick blue links are the cheapest routes to the gateway. Click a device to trace its route.
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5">Route</h2>

            <form class="d-flex gap-2 mb-3" @onsubmit="ShowRoute">
                <input class="form-control font-monospace" placeholder="Mac address of a device"
                       aria-label="Mac address of a device"
                       @bind="State.RouteSearch" @bind:event="oninput" />
                <button type="submit" class="btn btn-primary text-nowrap">Show route</button>
            </form>

            @if (_routeMessage != null)
            {
                <div class="text-muted">@_routeMessage</div>
            }

            @if (_route.Count > 0)
            {
                <div class="small text-muted mb-1">@(_route.Count - 1) hops to the gateway, cheapest route</div>
                <ol class="mb-0">
                    @foreach (var hop in _route)
                    {
                        <li>
                            @hop.Name
                            <span class="font-monospace text-muted small">@hop.Mac</span>
                            @if (hop.Rssi != null)
                            {
                                <span class="text-muted small">, @hop.Rssi dBm to the hop before</span>
                            }
                        </li>
                    }
                </ol>
            }

            @if (_alternatives.Count > 0)
            {
                <div class="mt-2">Neighbours that can still reach the gateway:</div>
                <ul class="mb-0">
                    @foreach (var mac in _alternatives)
                    {
                        <li class="font-monospace">@mac</li>
                    }
                </ul>
            }
        </div>
    </div>

    @if (ChosenDevice() is { } chosen)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5">Radio history for <span class="font-monospace">@chosen.MacAddress</span></h2>

                @if (chosen.IsGateway)
                {
                    <div class="text-muted">The gateway does not send readings, pick a device.</div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <div class="btn-group btn-group-sm" role="group" aria-label="History range">
                            @foreach (var (minutes, label) in HistoryRanges)
                            {
                                <button type="button" class="btn @(_historyMinutes == minutes ? "btn-primary" : "btn-outline-primary")"
                                        @onclick="() => ChooseRange(minutes)">@label</button>
                            }
                        </div>

                        <div class="btn-group btn-group-sm" role="group" aria-label="Radio number">
                            @foreach (var metric in Metrics)
                            {
                                <button type="button" class="btn @(_metric == metric ? "btn-primary" : "btn-outline-primary")"
                                        @onclick="() => ChooseMetric(metric)">@metric</button>
                            }
                        </div>
                    </div>

                    @if (_historyFailed)
                    {
                        <div class="alert alert-danger mb-0">Could not load the history for this device.</div>
                    }
                    else if (_history == null)
                    {
                        <div class="text-muted">Loading...</div>
                    }
                    else if (_history.Count == 0)
                    {
                        <div class="text-muted">
                            @(_historyMinutes == 0 ? "No readings kept for this device yet." : "No readings in this range.")
                        </div>
                    }
                    else
                    {
                        <div class="mb-2 text-primary">
                            <TimelineChart Points="_chart" />
                        </div>
                        <div class="small text-muted mb-2">Newest @Math.Min(_history.Count, HistoryRows) of @_history.Count in this range.</div>
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Recorded</th>
                                        <th>Signal</th>
                                        <th>Hops</th>
                                        <th>Duty cycle</th>
                                        <th>Packet loss</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var point in _history.AsEnumerable().Reverse().Take(HistoryRows))
                                    {
                                        <tr>
                                            <td class="text-muted small">@point.RecordedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                                            <td>@(point.Rssi?.ToString() ?? "-") dBm</td>
                                            <td>@(point.HopCount?.ToString() ?? "-")</td>
                                            <td>@(point.DutyCycle?.ToString("0.#") ?? "-")%</td>
                                            <td>@(point.PacketLoss?.ToString("0.#") ?? "-")%</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        </div>
    }

    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <h2 class="h5">Devices</h2>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Device</th>
                            <th>Mac Address</th>
                            <th>Hops</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var node in _mesh.Nodes)
                        {
                            <tr>
                                <td>@node.Name</td>
                                <td class="font-monospace">@node.MacAddress</td>
                                <td>@(node.HopCount?.ToString() ?? "-")</td>
                                <td>@DescribeStatus(node)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <h2 class="h5">Links</h2>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>From</th>
                            <th>To</th>
                            <th>Signal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var link in _mesh.Links)
                        {
                            <tr>
                                <td class="font-monospace">@link.MacA</td>
                                <td class="font-monospace">@link.MacB</td>
                                <td>@link.Rssi dBm</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    // The push does the quick refresh, the poll is only the fallback when the hub is down.
    private const int PollIntervalMilliseconds = 5000;

    private const double Centre = 250;
    private const double CircleRadius = 210;

    private TopologySnapshot? _mesh;
    private MeshTree? _tree;
    private bool _loadFailed;
    private bool _loading;
    private bool _treeOnly;
    private DateTime? _lastUpdated;
    private CancellationTokenSource? _polling;

    private readonly Dictionary<string, (double X, double Y)> _spots = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _treePairs = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _quiet = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, int> _rssi = new(StringComparer.OrdinalIgnoreCase);

    private readonly HashSet<string> _routePairs = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<RouteHop> _route = new();
    private readonly List<string> _alternatives = new();

    private MeshReach? _reach;
    private string _routeMac = string.Empty;
    private string? _routeMessage;

    private const int HistoryRows = 15;

    // Minutes back from now, where 0 means everything the tree kept.
    private static readonly (int Minutes, string Label)[] HistoryRanges =
    {
        (1, "Last minute"),
        (5, "Last 5 minutes"),
        (0, "All kept")
    };

    private static readonly string[] Metrics = { "Signal", "Hops", "Duty cycle", "Packet loss" };

    private List<TelemetryPoint>? _history;
    private readonly List<HistoryPoint> _chart = new();
    private bool _historyFailed;
    private bool _historyLoading;
    private int _historyMinutes = 5;
    private string _metric = "Signal";

    private record RouteHop(string Name, string Mac, int? Rssi);

    //says whether the route being traced uses this link
    private bool InRoute(TopologyLink link)
    {
        return _routePairs.Contains(PairKey(link.MacA, link.MacB));
    }

    //says whether this device is the one whose route is being traced
    private bool IsSelected(TopologyNode node)
    {
        return _routeMac.Length > 0 && string.Equals(node.MacAddress, _routeMac, StringComparison.OrdinalIgnoreCase);
    }

    //traces the typed mac address
    private async Task ShowRoute()
    {
        _routeMac = State.RouteSearch.Trim();
        UpdateRoute();

        _history = null;
        _historyFailed = false;
        await LoadHistoryAsync();
    }

    //fills the box with the clicked device and traces it
    private async Task SelectNode(string mac)
    {
        State.RouteSearch = mac;
        await ShowRoute();
    }

    //retrieves the device the route box points at, or null if it has not been seen
    private TopologyNode? ChosenDevice()
    {
        return _mesh?.Nodes.FirstOrDefault(n => string.Equals(n.MacAddress, _routeMac, StringComparison.OrdinalIgnoreCase));
    }

    //changes how far back the history card reaches
    private async Task ChooseRange(int minutes)
    {
        _historyMinutes = minutes;
        _history = null;
        _historyFailed = false;
        await LoadHistoryAsync();
    }

    //changes which radio number the chart draws
    private void ChooseMetric(string metric)
    {
        _metric = metric;
        RebuildChart();
    }

    //asks the api for the chosen device radio readings over the chosen range
    private async Task LoadHistoryAsync()
    {
        var device = ChosenDevice();

        if (device == null || device.IsGateway)
        {
            _history = null;
            _historyFailed = false;
            RebuildChart();
            return;
        }

        // The refresh also calls this, one request at a time is enough.
        if (_historyLoading)
        {
            return;
        }

        _historyLoading = true;

        try
        {
            var url = $"api/topology/{Uri.EscapeDataString(device.MacAddress)}/history";

            if (_historyMinutes > 0)
            {
                var from = DateTime.UtcNow.AddMinutes(-_historyMinutes);

                url += $"?from={Uri.EscapeDataString(from.ToString("o"))}";
            }

            _history = await Http.GetFromJsonAsync<List<TelemetryPoint>>(url, ApiJsonOptions.Default);
            _historyFailed = false;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            // The mesh has heard of the device but kept no readings from it, which is just an empty list.
            _history = new List<TelemetryPoint>();
            _historyFailed = false;
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _historyFailed = true;
        }
        finally
        {
            _historyLoading = false;
        }

        RebuildChart();
    }

    //turns the readings into the shape the timeline chart draws, leaving out any the device did not give a number for
    private void RebuildChart()
    {
        _chart.Clear();

        if (_history == null)
        {
            return;
        }

        foreach (var point in _history)
        {
            var reading = _metric switch
            {
                "Hops" => point.HopCount == null ? null : $"{point.HopCount} hops",
                "Duty cycle" => point.DutyCycle == null ? null : $"{point.DutyCycle:0.#}%",
                "Packet loss" => point.PacketLoss == null ? null : $"{point.PacketLoss:0.#}%",
                _ => point.Rssi == null ? null : $"{point.Rssi} dBm"
            };

            if (reading != null)
            {
                _chart.Add(new HistoryPoint { RecordedAt = point.RecordedAt, Reading = reading, Rssi = point.Rssi });
            }
        }
    }

    //works out the hop path for the chosen device from the tree, or says why there is none
    private void UpdateRoute()
    {
        _route.Clear();
        _routePairs.Clear();
        _alternatives.Clear();
        _routeMessage = null;

        if (_mesh == null || _tree == null || _routeMac.Length == 0)
        {
            return;
        }

        var target = _mesh.Nodes.FirstOrDefault(n => string.Equals(n.MacAddress, _routeMac, StringComparison.OrdinalIgnoreCase));

        if (target == null)
        {
            _routeMessage = "No device with that mac address has been seen.";
            return;
        }

        if (target.IsGateway)
        {
            _routeMessage = "That is the gateway, every route ends here.";
            return;
        }

        if (!_tree.Parents.ContainsKey(target.MacAddress))
        {
            if (target.Disconnected)
            {
                _routeMessage = $"{target.Name} has gone quiet, so it has no route.";

                if (_reach != null && _reach.Reroutes.TryGetValue(target.MacAddress, out var neighbours))
                {
                    _alternatives.AddRange(neighbours);
                }
            }
            else
            {
                _routeMessage = $"{target.Name} is cut off, every way to the gateway runs through a quiet device.";
            }

            return;
        }

        // Walk up the parents to the gateway, then turn it round so the gateway comes first.
        var macs = new List<string> { target.MacAddress };

        while (macs.Count <= _mesh.Nodes.Count && _tree.Parents.TryGetValue(macs[^1], out var parent))
        {
            macs.Add(parent);
        }

        macs.Reverse();

        for (var i = 0; i < macs.Count; i++)
        {
            var node = _mesh.Nodes.FirstOrDefault(n => string.Equals(n.MacAddress, macs[i], StringComparison.OrdinalIgnoreCase));
            int? rssi = null;

            if (i > 0)
            {
                var key = PairKey(macs[i - 1], macs[i]);

                _routePairs.Add(key);

                if (_rssi.TryGetValue(key, out var found))
                {
                    rssi = found;
                }
            }

            _route.Add(new RouteHop(node?.Name ?? macs[i], macs[i], rssi));
        }
    }

    //places the gateway in the middle and every other device round one circle, in the order the api listed them
    private void BuildLayout()
    {
        _spots.Clear();
        _treePairs.Clear();
        _quiet.Clear();
        _rssi.Clear();

        if (_mesh == null)
        {
            return;
        }

        var others = _mesh.Nodes.Where(n => !n.IsGateway).ToList();

        for (var i = 0; i < others.Count; i++)
        {
            var angle = 2 * Math.PI * i / others.Count;

            _spots[others[i].MacAddress] = (Centre + CircleRadius * Math.Cos(angle), Centre + CircleRadius * Math.Sin(angle));
        }

        foreach (var node in _mesh.Nodes)
        {
            if (node.IsGateway)
            {
                _spots[node.MacAddress] = (Centre, Centre);
            }

            if (node.Disconnected)
            {
                _quiet.Add(node.MacAddress);
            }
        }

        foreach (var link in _mesh.Links)
        {
            _rssi[PairKey(link.MacA, link.MacB)] = link.Rssi;
        }

        if (_tree != null)
        {
            foreach (var edge in _tree.Edges)
            {
                _treePairs.Add(PairKey(edge.MacA, edge.MacB));
            }
        }
    }

    //joins two macs in a fixed order so a link reads the same from either end
    private static string PairKey(string a, string b)
    {
        return string.Compare(a, b, StringComparison.OrdinalIgnoreCase) <= 0 ? $"{a}|{b}" : $"{b}|{a}";
    }

    //retrieves where a device sits in the drawing, the middle if it is not placed
    private (double X, double Y) Position(string mac)
    {
        return _spots.TryGetValue(mac, out var spot) ? spot : (Centre, Centre);
    }

    //says whether the cheapest-route tree uses this link
    private bool InTree(TopologyLink link)
    {
        return _treePairs.Contains(PairKey(link.MacA, link.MacB));
    }

    //says whether either end of the link has gone quiet
    private bool IsQuietLink(TopologyLink link)
    {
        return _quiet.Contains(link.MacA) || _quiet.Contains(link.MacB);
    }

    //picks the colour class for a device: gateway, quiet, cut off from the gateway, or up
    private string NodeClass(TopologyNode node)
    {
        if (node.IsGateway)
        {
            return "mesh-node-gateway";
        }

        if (node.Disconnected)
        {
            return "mesh-node-quiet";
        }

        if (_tree != null && _tree.Unreached.Contains(node.MacAddress, StringComparer.OrdinalIgnoreCase))
        {
            return "mesh-node-cut";
        }

        return "mesh-node-up";
    }

    //says whether a device is the gateway, has gone quiet, or is reporting
    private static string DescribeStatus(TopologyNode node)
    {
        if (node.IsGateway)
        {
            return "Gateway";
        }

        return node.Disconnected ? "Quiet" : "Up";
    }

    protected override async Task OnInitializedAsync()
    {
        State.OnStreamChanged += OnStreamChanged;

        // The box keeps what was typed from an earlier visit, so trace it again.
        _routeMac = State.RouteSearch.Trim();

        await LoadMeshAsync();

        _polling = new CancellationTokenSource();

        _ = PollAsync(_polling.Token);

        // Opened after the first load so a slow hub never holds the page up.
        await State.StartAsync();
    }

    //reloads the mesh when the api says the stream moved on
    private void OnStreamChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadMeshAsync();
            StateHasChanged();
        });
    }

    private async Task PollAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(PollIntervalMilliseconds));

        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (!State.Connected)
                {
                    await State.StartAsync();
                }

                await LoadMeshAsync();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadMeshAsync()
    {
        // A burst of pushes would stack requests, one load at a time is enough.
        if (_loading)
        {
            return;
        }

        _loading = true;

        try
        {
            _mesh = await Http.GetFromJsonAsync<TopologySnapshot>("api/topology", ApiJsonOptions.Default);
            _tree = await Http.GetFromJsonAsync<MeshTree>("api/topology/mst", ApiJsonOptions.Default);
            _reach = await Http.GetFromJsonAsync<MeshReach>("api/topology/reach", ApiJsonOptions.Default);
            BuildLayout();
            UpdateRoute();
            await LoadHistoryAsync();
            _loadFailed = false;
            _lastUpdated = DateTime.UtcNow;
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
        State.OnStreamChanged -= OnStreamChanged;

        _polling?.Cancel();
        _polling?.Dispose();
    }
}
